{
  "folders": [
    {
      "path": ".",
      "name": "AI 영상 분류 모델 · 최종"
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "python",
    "python.analysis.extraPaths": [
      "${workspaceFolder}/src"
    ],
    "files.exclude": {
      "**/__pycache__": true,
      ".gradio": true,
      ".local": true,
      ".tools": true,
      ".venvs": true,
      ".venv": true,
      ".vscode": true,
      "archive": true,
      "checkpoints": true,
      "models": true,
      "reports": true,
      "tmp": true,
      "data/raw": true,
      "data/cache": true,
      "data/metadata": true,
      "AI_video_training.code-workspace": true,
      "start_final_model.bat": true,
      "test_latest_model.bat": true
    },
    "files.watcherExclude": {
      "**/data/**": true,
      "**/archive/**": true,
      "**/.tools/**": true
    },
    "search.exclude": {
      "**/data/**": true,
      "**/archive/**": true,
      "**/.tools/**": true
    },
    "terminal.integrated.cwd": "${workspaceFolder}"
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "모델 실행 · 64프레임",
        "type": "shell",
        "command": ".\\start_64frame_model.bat",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": []
      },
      {
        "label": "최종 파일 검사 · 학습·예측 안 함",
        "type": "process",
        "command": "${command:python.interpreterPath}",
        "args": [
          "${workspaceFolder}/tools/release.py",
          "check"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": []
      }
    ]
  }
}
