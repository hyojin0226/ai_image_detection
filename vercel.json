{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node --test tests/*.test.mjs && node scripts/build-vercel.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/auth/:path*", "destination": "/api/handler" },
    { "source": "/api/auth", "destination": "/api/handler" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" }
    ] },
    { "source": "/model/:path*", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
    ] }
  ]
}
