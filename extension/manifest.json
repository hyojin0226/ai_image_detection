{
  "manifest_version": 3,
  "name": "Fakit — 이미지 주소 가져오기",
  "version": "0.3.0",
  "description": "웹페이지의 이미지를 우클릭해 Fakit으로 주소를 가져옵니다.",
  "homepage_url": "https://aiimagedetection-rho.vercel.app/",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Fakit", "default_popup": "popup.html" },
  "permissions": ["contextMenus"],
  "background": { "service_worker": "background.js", "type": "module" }
}
