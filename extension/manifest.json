{
  "manifest_version": 3,
  "name": "AI Face Detector (Local)",
  "version": "0.1.0",
  "description": "페이지의 얼굴 이미지를 로컬 서버로 보내 REAL / FAKE(AI 생성) 확률을 표시합니다.",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
